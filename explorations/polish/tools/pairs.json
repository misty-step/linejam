{
  "about": "Before (current app, captured from real multiplayer play) paired with After (Tucked In synthesis prototype). after.screen is a synthesis screen id; optional variant fields: theme (light|dark), vp (390|320|kb|desk), text (200), scroll (bottom), full (true), reduce (true). before is null for states the survey could not force; beforeSkipped names the skipped survey row.",
  "summary": "Before: today's Linejam (revision 66d448d) played for real by four isolated players and a late joiner on the isolated local stack on linejam-ws, captured in headless Chromium at 390x844 unless noted. After: the Tucked In synthesis, a static HTML prototype on the shared kit (the product's own tokens, fonts, characters and copy rules), rendered in the same VM Chromium. After images are proposals: they prove appearance, not product behavior, and nothing here changes the live app. Click any image for full size.",
  "directions": [
    { "id": "tidy-room", "name": "1. Tidy Room", "range": "conservative", "verdict": "Spine of the synthesis", "prototype": "prototype/concepts/tidy-room/index.html?screen=lobby-host", "stance": "Same rooms, less noise: today's structure with one focal point per screen, a quiet shared header, anchored menus and three short motions.", "critique": "Clearest and cheapest; closes the reading, writing and chrome gaps. Alone it lacks delight." },
    { "id": "passing-notes", "name": "2. Passing Notes", "range": "evolutionary", "verdict": "Merged: the note and the tuck", "prototype": "prototype/concepts/passing-notes/index.html?screen=lobby-host", "stance": "The poem is a folded note passed hand to hand; its fold and its pass show what happened.", "critique": "Most legible acceptance moment; the side-to-side passing costs about 1.3 s a round, nine times, so only the note and the tuck survive." },
    { "id": "round-table", "name": "3. Round Table", "range": "radical", "verdict": "Rejected as spine; the reading lamp survives", "stance": "Everyone sits around one table on every screen; seats carry status and turns.", "critique": "Warm lobby and the clearest whose-turn signal, but the ring is the loudest thing while you write and needs a second layout at large text." },
    { "id": "poem-shape", "name": "4. Poem Shape", "range": "radical", "verdict": "Merged: the round glyph and the Lines by key", "stance": "The 1-2-3-4-5-4-3-2-1 shape is the map of the game on every screen.", "critique": "Calmest motion and the best attribution idea; the silhouettes drift into a progress dashboard." },
    { "id": "cast-companion", "name": "5. Cast Companion", "range": "evolutionary", "verdict": "Merged: the warmth layer", "stance": "Your character stays with you; props carry state beside the words.", "critique": "Sticker edge fixes the cast in Dark; props and the gathering add warmth. The dock costs too much height with a keyboard open." },
    { "id": "lights-down", "name": "6. Lights Down (wildcard)", "range": "out of frame", "verdict": "Rejected; three pieces survive", "stance": "While a poem is read aloud, listeners' phones go dark and only the reader's phone is a page.", "critique": "True to reading aloud, but breaks two locked rules and loses deaf and distracted listeners. The listener sentence, the reader's page and Nicely read survive." },
    { "id": "synthesis", "name": "Synthesis: Tucked In", "range": "recommended", "verdict": "Recommended direction", "prototype": "prototype/synthesis/index.html?screen=13-lobby-host-ready", "stance": "Keep today's rooms, give every screen one focal point, let the cast carry the warmth, and let one fold explain every hand-off.", "critique": "Spine from Tidy Room; note and tuck from Passing Notes; sticker edge, props and gathering from Cast Companion; round glyph, Lines by key and reader-only action from Poem Shape; reading lamp from Round Table; listener sentence and reader's page from Lights Down." }
  ],
