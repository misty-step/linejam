#!/usr/bin/env node
// Source-bound, credential-free product walk. The only publishable output is target/walk/.
import { spawn, execFileSync } from 'node:child_process';
import { createHash, randomBytes } from 'node:crypto';
import { createServer } from 'node:net';
import { constants, createReadStream, existsSync } from 'node:fs';
import {
  access,
  lstat,
  mkdir,
  mkdtemp,
  open,
  readFile,
  realpath,
  rm,
  writeFile,
} from 'node:fs/promises';
import { homedir } from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { sourceIdentity } from '../scripts/local/identity.mjs';

const root = await realpath(fileURLToPath(new URL('../', import.meta.url)));
const output = path.join(root, 'target/walk');
const marker = path.join(output, '.linejam-walk-owned');
const stamp = () => new Date().toISOString();
const sha256 = (bytes) => createHash('sha256').update(bytes).digest('hex');
const git = (...args) =>
  execFileSync('git', args, {
    cwd: root,
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  }).trim();
let activeChild = null;
let interrupted = false;
let cleaning = false;
let dockerWrapperDir = null;

function shellQuote(value) {
  return "'" + value.replaceAll("'", "'\\''") + "'";
}

async function prepareIsolatedComposePlugin(state, scratch) {
  const source = path.join(
    process.env.HOME || homedir(),
    '.docker/cli-plugins/docker-compose'
  );
  let binary;
  try {
    binary = await realpath(source);
  } catch (error) {
    if (error.code === 'ENOENT') return; // A system-installed Compose plugin remains available.
    throw error;
  }
  const hash = createHash('sha256');
  for await (const chunk of createReadStream(binary)) hash.update(chunk);
  if (
    hash.digest('hex') !==
    'db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576'
  ) {
    throw new Error(
      'User Compose plugin does not match the verified setup binary.'
    );
  }
  const executable = await (async () => {
    for (const directory of (process.env.PATH || '').split(path.delimiter)) {
      if (!path.isAbsolute(directory)) continue;
      const candidate = path.join(directory, 'docker');
      try {
        await access(candidate, constants.X_OK);
        return realpath(candidate);
      } catch {}
    }
    throw new Error('Docker CLI is unavailable.');
  })();
  const config = path.join(state, 'docker-config');
  const destination = path.join(config, 'cli-plugins/docker-compose');
  // The local CLI sets DOCKER_CONFIG to the new project's private directory.
  // Only this pinned executable is exposed there; never copy ~/.docker/config.json.
  const wrapper = `#!/bin/sh
set -eu
[ \"\${DOCKER_CONFIG:-}\" = ${shellQuote(config)} ] || exit 76
mkdir -p -- ${shellQuote(path.dirname(destination))}
if [ -L ${shellQuote(destination)} ]; then
  [ \"$(readlink ${shellQuote(destination)})\" = ${shellQuote(binary)} ] || exit 76
elif [ -e ${shellQuote(destination)} ]; then
  exit 76
else
  ln -s -- ${shellQuote(binary)} ${shellQuote(destination)}
fi
exec ${shellQuote(executable)} \"$@\"
`;
  await writeFile(path.join(scratch, 'docker'), wrapper, {
    mode: 0o700,
    flag: 'wx',
  });
  dockerWrapperDir = scratch;
}

function storiesAtHead(source) {
  const headings = [...source.matchAll(/^## (US-\d{3})\b[^\n]*$/gm)];
  const result = new Map();
  for (let i = 0; i < headings.length; i++) {
    const start = headings[i].index;
    const next = source.indexOf('\n## ', start + 4);
    const section = source.slice(start, next === -1 ? undefined : next);
    if (/\bretired\b|\bsuperseded by\b/i.test(section)) continue;
    result.set(
      headings[i][1],
      [
        ...section.matchAll(/^(\d+)\. (?:WHEN|IF|WHILE|WHERE|THE\b|EACH\b)/gm),
      ].map((match) => Number(match[1]))
    );
  }
  return result;
}

function parse(live) {
  const argv = process.argv.slice(2);
  if (argv.length === 1 && argv[0] === '--help') {
    console.log('usage: qa/walk --all | --stories "US-001 US-002"');
    return null;
  }
  if (argv.length === 1 && argv[0] === '--all') return [...live.keys()];
  if (argv.length === 2 && argv[0] === '--stories') {
    // An empty affected set still produces honest evidence for every live story.
    const selected = [...new Set(argv[1].trim().split(/\s+/).filter(Boolean))];
    for (const id of selected)
      if (!live.has(id)) throw new Error(`Unknown live story: ${id}`);
    return selected.length ? selected : [...live.keys()];
  }
  throw new Error('usage: qa/walk --all | --stories "US-001 US-002"');
}

async function prepareOutput() {
  if (existsSync(output)) {
    const stat = await lstat(output);
    if (
      !stat.isDirectory() ||
      stat.isSymbolicLink() ||
      !existsSync(marker) ||
      (await readFile(marker, 'utf8')) !== 'Generated by qa/walk only.\n'
    ) {
      throw new Error('Refusing to replace non-owned target/walk output.');
    }
    await rm(output, { recursive: true });
  }
  await mkdir(path.join(output, 'artifacts'), { recursive: true });
  await writeFile(marker, 'Generated by qa/walk only.\n', { mode: 0o600 });
}

function assertCleanSource(head) {
  if (
    git('rev-parse', 'HEAD') !== head ||
    git(
      'status',
      '--porcelain',
      '--untracked-files=all',
      '--',
      '.',
      ':(exclude)target/walk'
    ) !== ''
  ) {
    throw new Error(
      'A source-bound walk requires a clean, unchanged HEAD (except its own output).'
    );
  }
}

async function freePorts(count) {
  const servers = [];
  try {
    for (let i = 0; i < count; i++) {
      const server = createServer();
      servers.push(server);
      await new Promise((resolve, reject) => {
        server.once('error', reject);
        server.listen(0, '127.0.0.1', resolve);
      });
    }
    return servers.map((server) => server.address().port);
  } finally {
    await Promise.all(
      servers.map((server) => new Promise((resolve) => server.close(resolve)))
    );
  }
}

async function command(
  binary,
  args,
  env,
  privateLog,
  { allowFailure = false, cleanup = false } = {}
) {
  if (interrupted && !cleanup) throw new Error('Walk interrupted.');
  const log = await open(privateLog, 'wx', 0o600);
  try {
    const child = spawn(binary, args, {
      cwd: root,
      env,
      stdio: ['ignore', log.fd, log.fd],
    });
    activeChild = child;
    const code = await new Promise((resolve, reject) => {
      child.once('error', reject);
      child.once('close', (status) => resolve(status));
    });
    if (interrupted && !cleanup) throw new Error('Walk interrupted.');
    if (code !== 0 && !allowFailure) throw new Error('Private command failed.');
    return code;
  } finally {
    activeChild = null;
    await log.close();
  }
}

function hostEnvironment(home) {
  // No inherited dotenv, cloud/provider credentials, registry login, or browser profile.
  return {
    PATH: `${dockerWrapperDir ? `${dockerWrapperDir}:` : ''}${process.env.PATH || '/usr/bin:/bin'}`,
    HOME: home,
    LANG: 'C.UTF-8',
    ...(process.env.DOCKER_HOST
      ? { DOCKER_HOST: process.env.DOCKER_HOST }
      : {}),
  };
}

function dockerEnvironment(state) {
  return {
    PATH: process.env.PATH || '/usr/bin:/bin',
    HOME: state,
    LANG: 'C.UTF-8',
    DOCKER_CONFIG: path.join(state, 'docker-config'),
    COMPOSE_DISABLE_ENV_FILE: '1',
    COMPOSE_INTERACTIVE_NO_CLI: '1',
  };
}

async function artifact(receipt, name, observations) {
  const relative = `artifacts/${name}.json`;
  const absolute = path.join(output, relative);
  await writeFile(absolute, `${JSON.stringify(observations, null, 2)}\n`, {
    mode: 0o600,
  });
  receipt.artifacts.push({
    path: relative,
    sha256: sha256(await readFile(absolute)),
  });
  return relative;
}

function validatedCriteria(story, expected) {
  if (
    !story ||
    !['pass', 'fail', 'unwalked'].includes(story.status) ||
    !Array.isArray(story.criteria)
  )
    return null;
  const criteria = [];
  for (const n of expected) {
    const found = story.criteria.filter((value) => value?.n === n);
    if (
      found.length !== 1 ||
      !['pass', 'fail', 'unwalked'].includes(found[0].status)
    )
      return null;
    const values = found[0].observations;
    if (
      !values ||
      typeof values !== 'object' ||
      Array.isArray(values) ||
      Object.entries(values).some(
        ([key, value]) =>
          !/^[a-z][A-Za-z0-9]{0,48}$/.test(key) ||
          !(
            typeof value === 'boolean' ||
            (Number.isSafeInteger(value) && value >= 0 && value < 1000)
          )
      )
    )
      return null;
    if (found[0].status === 'pass' && Object.keys(values).length === 0)
      return null;
    criteria.push({ n, status: found[0].status, observations: values });
  }
  if (
    criteria.length !== story.criteria.length ||
    (story.status === 'pass') !==
      criteria.every((value) => value.status === 'pass')
  )
    return null;
  return criteria;
}

async function main() {
  const source = await readFile(path.join(root, 'USER_STORIES.md'), 'utf8');
  const live = storiesAtHead(source);
  const selected = parse(live);
  if (selected === null) return;
  const head = git('rev-parse', 'HEAD');
  const tree = git('rev-parse', 'HEAD^{tree}');
  const baseInput = process.env.WALK_BASE;
  if (baseInput && !/^[0-9a-f]{40}$/.test(baseInput))
    throw new Error('WALK_BASE must be a commit SHA.');
  const base = baseInput ? git('rev-parse', `${baseInput}^{commit}`) : null;
  await prepareOutput();
  const receipt = {
    schema: 'foundation-walk-receipt/1',
    check: 'linejam-local-product-walk',
    run: `${/^\d+$/.test(process.env.GITHUB_RUN_ID || '') ? process.env.GITHUB_RUN_ID : 'local'}-${/^\d+$/.test(process.env.GITHUB_RUN_ATTEMPT || '') ? process.env.GITHUB_RUN_ATTEMPT : '1'}-${randomBytes(5).toString('hex')}`,
    head,
    tree,
    base,
    started_at: stamp(),
    finished_at: '',
    exit: 1,
    stories: [],
    artifacts: [],
    failure_phases: [],
  };
  const suffix = `walk-${randomBytes(8).toString('hex')}`;
  const project = `linejam-local-${suffix}`;
  const state = path.join(root, '.qa/local', project);
  const scratchRoot = path.join(
    process.env.XDG_CACHE_HOME ||
      path.join(process.env.HOME || homedir(), '.cache'),
    'tmp'
  );
  await mkdir(scratchRoot, { recursive: true, mode: 0o700 });
  const scratch = await mkdtemp(path.join(scratchRoot, 'linejam-walk-'));
  let attemptedStartup = false;
  let failure = false;
  let phase = 'setup';
  const failurePhases = new Set();
  const onInterrupt = (signal) => {
    interrupted = true;
    if (!cleaning) activeChild?.kill(signal);
  };
  const onSigint = () => onInterrupt('SIGINT');
  const onSigterm = () => onInterrupt('SIGTERM');
  process.on('SIGINT', onSigint);
  process.on('SIGTERM', onSigterm);
  try {
    assertCleanSource(head);
    if (existsSync(state))
      throw new Error('Fresh project name was already owned.');
    await prepareIsolatedComposePlugin(state, scratch);
    const [app, convex, site] = await freePorts(3);
    const local = (commandName) => [
      'scripts/local/cli.mjs',
      commandName,
      '--project',
      suffix,
      ...(commandName === 'up'
        ? [
            '--app-port',
            String(app),
            '--convex-port',
            String(convex),
            '--site-port',
            String(site),
          ]
        : []),
    ];
    phase = 'up';
    attemptedStartup = true;
    await command(
      'node',
      local('up'),
      hostEnvironment(scratch),
      path.join(scratch, 'up.log')
    );
    phase = 'identity';
    const owner = JSON.parse(
      await readFile(path.join(state, 'owner.json'), 'utf8')
    );
    const ready = JSON.parse(
      await readFile(path.join(state, 'receipt.json'), 'utf8')
    );
    const identity = await sourceIdentity();
    if (
      owner.project !== project ||
      owner.checkout !== root ||
      ready.project !== project ||
      ready.readiness?.guestTokenParity !== true ||
      ready.source?.frontend?.sha256 !== identity.frontend.sha256 ||
      ready.source?.backend?.sha256 !== identity.backend.sha256
    ) {
      throw new Error(
        'Local runtime source or guest authorization differs from this checkout.'
      );
    }
    const docker = (action) => [
      '--host',
      owner.dockerHost,
      'compose',
      '--project-directory',
      root,
      '--file',
      path.join(root, 'compose.yaml'),
      '--env-file',
      path.join(state, 'compose.env'),
      '--project-name',
      project,
      '--profile',
      'tools',
      ...action,
    ];
    phase = 'build';
    await command(
      'docker',
      docker(['build', 'qa']),
      dockerEnvironment(state),
      path.join(scratch, 'build-qa.log')
    );
    phase = 'browser';
    const browserCode = await command(
      'docker',
      docker([
        'run',
        '--rm',
        '--no-deps',
        '-T',
        '-e',
        `WALK_STORIES=${JSON.stringify(selected)}`,
        '--entrypoint',
        'node',
        'qa',
        'qa/walk-specs.mjs',
      ]),
      dockerEnvironment(state),
      path.join(scratch, 'browser.log'),
      { allowFailure: true }
    );
    if (browserCode !== 0) {
      failure = true;
      failurePhases.add('browser');
    }
    phase = 'receipt';
    const raw = JSON.parse(
      await readFile(
        path.join(state, 'artifacts/walk/observations.json'),
        'utf8'
      )
    );
    if (!Array.isArray(raw.stories) || raw.stories.length !== selected.length) {
      throw new Error('Browser did not report every selected story.');
    }
    for (const id of selected) {
      const reported = raw.stories.filter((value) => value?.id === id);
      const criteria = validatedCriteria(
        reported.length === 1 ? reported[0] : null,
        live.get(id)
      );
      if (!criteria) {
        receipt.stories.push({ id, status: 'fail', criteria: [] });
        failure = true;
        failurePhases.add('receipt');
        continue;
      }
      const evidence = [];
      for (const { n, status, observations } of criteria) {
        const name = await artifact(receipt, `${id}-${n}`, {
          story: id,
          criterion: n,
          status,
          target: 'isolated-local-docker-playwright',
          identity: 'independent-guest-contexts',
          observations,
        });
        evidence.push({ n, status, evidence: [name] });
      }
      const status = reported[0].status;
      receipt.stories.push({ id, status, criteria: evidence });
      if (status !== 'pass') failure = true;
    }
    phase = 'identity';
    assertCleanSource(head);
    const after = await sourceIdentity();
    if (
      after.frontend.sha256 !== identity.frontend.sha256 ||
      after.backend.sha256 !== identity.backend.sha256
    ) {
      throw new Error('Source changed after local runtime synchronization.');
    }
  } catch {
    failure = true;
    failurePhases.add(phase);
  } finally {
    cleaning = true;
    if (interrupted) failure = true;
    if (attemptedStartup && existsSync(state)) {
      try {
        await command(
          'node',
          [
            'scripts/local/cli.mjs',
            'reset',
            '--project',
            suffix,
            '--confirm',
            project,
          ],
          hostEnvironment(scratch),
          path.join(scratch, 'reset.log'),
          { cleanup: true }
        );
      } catch {
        failure = true;
        failurePhases.add('cleanup');
      }
    }
    try {
      await rm(scratch, { recursive: true });
    } catch {
      failure = true;
      failurePhases.add('cleanup');
    }
    for (const id of selected) {
      if (!receipt.stories.some((story) => story.id === id)) {
        receipt.stories.push({ id, status: 'unwalked', criteria: [] });
      }
    }
    receipt.failure_phases = [...failurePhases];
    receipt.exit =
      failure || receipt.stories.some((story) => story.status !== 'pass')
        ? 1
        : 0;
    receipt.finished_at = stamp();
    await writeFile(
      path.join(output, 'walk-receipt.json'),
      `${JSON.stringify(receipt, null, 2)}\n`,
      { mode: 0o600 }
    );
    console.log(
      `Linejam story walk: ${receipt.stories.filter((story) => story.status === 'pass').length}/${selected.length} pass; receipt target/walk/walk-receipt.json`
    );
    if (receipt.exit)
      console.error(
        'Walk failed or fixture cleanup failed; no raw browser or credential artifacts were published.'
      );
    process.off('SIGINT', onSigint);
    process.off('SIGTERM', onSigterm);
  }
  if (receipt.exit) process.exitCode = 1;
}

main().catch(() => {
  console.error('Story walk could not initialize; no pass receipt was issued.');
  process.exitCode = 1;
});
