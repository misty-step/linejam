{
  "schemaVersion": 1,
  "organization": "misty-step",
  "project": "linejam",
  "projectId": "4510762050650112",
  "issueAlerts": {
    "required": [
      {
        "name": "Linejam scheduled jobs: missed or failed check-in",
        "enabled": true,
        "action": {
          "type": "webhook",
          "status": "active",
          "target": "kaylee-alert-intake-2edba9"
        },
        "trigger": {
          "logic": "any-short",
          "conditionTypes": [
            "first_seen_event",
            "regression_event",
            "reappeared_event"
          ]
        },
        "filterLogic": "any-short",
        "frequencyMinutes": 5
      },
      {
        "name": "Regression Alert",
        "enabled": true,
        "action": {
          "type": "webhook",
          "status": "active",
          "target": "kaylee-alert-intake-2edba9"
        }
      },
      {
        "name": "Linejam: new issue",
        "enabled": true,
        "unfiltered": true,
        "action": {
          "type": "webhook",
          "status": "active",
          "target": "kaylee-alert-intake-2edba9"
        },
        "trigger": { "logic": "all", "conditionTypes": ["first_seen_event"] },
        "filterLogic": "all",
        "frequencyMinutes": 5
      },
      {
        "name": "High frequency error spike",
        "enabled": true,
        "action": {
          "type": "webhook",
          "status": "active",
          "target": "kaylee-alert-intake-2edba9"
        }
      },
      {
        "name": "Send a notification for high priority issues",
        "enabled": true,
        "action": {
          "type": "webhook",
          "status": "active",
          "target": "kaylee-alert-intake-2edba9"
        }
      }
    ]
  },
  "uptimeMonitors": {
    "required": [
      {
        "id": "8094070",
        "name": "Linejam production health",
        "projectSlug": "linejam",
        "status": "active",
        "environment": "production",
        "url": "https://linejam.mistystep.io/api/health",
        "method": "GET",
        "intervalSeconds": 60,
        "timeoutMs": 10000,
        "recoveryThreshold": 1,
        "downtimeThreshold": 3,
        "traceSampling": false,
        "responseCaptureEnabled": false
      }
    ]
  },
  "cronMonitors": {
    "required": [
      {
        "slug": "linejam-production-smoke",
        "status": "active",
        "isMuted": false,
        "schedule": "17 * * * *",
        "timezone": "UTC",
        "maxRuntimeMinutes": 15,
        "checkinMarginMinutes": 60,
        "recoveryThreshold": 1,
        "failureIssueThreshold": 3,
        "environments": ["production"]
      },
      {
        "slug": "linejam-convex-backup",
        "status": "active",
        "isMuted": false,
        "schedule": "17 9 * * *",
        "timezone": "UTC",
        "maxRuntimeMinutes": 15,
        "checkinMarginMinutes": 60,
        "recoveryThreshold": 1,
        "failureIssueThreshold": 1,
        "environments": ["production"]
      },
      {
        "slug": "linejam-abandonment-sweep",
        "status": "active",
        "isMuted": false,
        "schedule": "* * * * *",
        "timezone": "UTC",
        "maxRuntimeMinutes": 1,
        "checkinMarginMinutes": 1,
        "recoveryThreshold": 1,
        "failureIssueThreshold": 1,
        "environments": ["production"]
      }
    ],
    "forbidden": ["linejam-production-health", "linejam-ai-fallback-rate"]
  },
  "release": {
    "requiresDeployMarker": true,
    "environment": "production"
  },
  "dashboard": {
    "id": "9551300",
    "title": "Linejam Reliability",
    "requiredWidgets": [
      "Unresolved Errors",
      "Error Volume",
      "Errors by Release",
      "Operational Failures",
      "Slow Transactions"
    ]
  }
}
