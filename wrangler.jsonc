{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top level is the local Worker (`pnpm dev`, tests). Production is `env.production`.
  "name": "linejam-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": true },
  // One build produces everything the Worker serves: checksum-verified folio
  // assets, token CSS, self-hosted fonts, raster icons and the client bundle.
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "ARCHIVE", "class_name": "ArchiveDO" },
      // Sealed legacy store. See src/legacy-vault.ts.
      { "name": "LEGACY_VAULT", "class_name": "LinejamBackend" },
    ],
  },
  "migrations": [
    // The pre-recompile backend object. Its tag stays so a deploy over the
    // existing Worker neither re-creates nor deletes the stored player data.
    { "tag": "linejam-backend-v1", "new_sqlite_classes": ["LinejamBackend"] },
    { "tag": "cleanroom-v1", "new_sqlite_classes": ["RoomDO", "ArchiveDO"] },
  ],
  // Secrets, bound with `wrangler secret put` (never committed):
  //   GUEST_TOKEN_SECRET  signs guest credentials; the Worker refuses to issue
  //                       or accept credentials without it.
  //   LINEJAM_ADMIN_KEY   enables the operator import route; unset = 401.
  //   SENTRY_DSN          forwards scrubbed errors to Sentry; unset = no-op.
  "vars": { "LINEJAM_ENVIRONMENT": "local", "RETENTION_GC_ENABLED": "1" },
  "env": {
    "production": {
      "name": "linejam",
      "routes": [{ "pattern": "linejam.mistystep.io", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "ARCHIVE", "class_name": "ArchiveDO" },
          { "name": "LEGACY_VAULT", "class_name": "LinejamBackend" },
        ],
      },
      // Retention deletion stays dry-run in production until an operator
      // enables it on purpose; the sweep still reports what is eligible.
      "vars": { "LINEJAM_ENVIRONMENT": "production", "RETENTION_GC_ENABLED": "0" },
    },
  },
}
