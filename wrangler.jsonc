{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linejam",
  "account_id": "b069014f6a46558ea9146fb6c4ff8f6c",
  // cloudflare/worker.ts routes /backend/* to the Convex-compatible Durable
  // Object (cloudflare/backend.ts) and everything else to the OpenNext build.
  "main": "cloudflare/worker.ts",
  "alias": { "open-next-worker": "./.open-next/worker.js" },
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // One SQLite Durable Object holds the whole backend. A new deployment starts
  // with writes frozen until an operator imports data or unfreezes it.
  "durable_objects": {
    "bindings": [{ "name": "LINEJAM_BACKEND", "class_name": "LinejamBackend" }],
  },
  "migrations": [
    { "tag": "linejam-backend-v1", "new_sqlite_classes": ["LinejamBackend"] },
  ],
  "env": {
    // Staging: workers.dev URL only. No routes, no custom domains.
    // Backends are development-scoped (dev Convex deployment + Clerk dev
    // instance + dev GUEST_TOKEN_SECRET), so staging proves the OpenNext
    // runtime without touching production contracts.
    // Build: pnpm build:cf     Deploy: pnpm deploy:cf:staging
    "staging": {
      "name": "linejam-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "LINEJAM_BACKEND", "class_name": "LinejamBackend" },
        ],
      },
      "vars": {
        "NEXT_PUBLIC_CONVEX_URL": "https://exuberant-bloodhound-885.convex.cloud",
        "NEXT_PUBLIC_SENTRY_ENABLED": "1",
        "SENTRY_ORG": "misty-step",
        "SENTRY_PROJECT": "linejam",
        "LINEJAM_DEPLOY_ENVIRONMENT": "development",
      },
      // Key values are never committed (gitleaks flags Clerk key material).
      // NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and the server secrets
      // (GUEST_TOKEN_SECRET, CLERK_SECRET_KEY) are bound at deploy with
      // `wrangler secret put <NAME> --env staging` from the approved store.
    },
    // Production home: linejam.mistystep.io in the active mistystep.io zone.
    // Deploy: pnpm deploy:cf:production (after secrets are bound)
    "production": {
      "name": "linejam",
      "workers_dev": false,
      "routes": [{ "pattern": "linejam.mistystep.io", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "LINEJAM_BACKEND", "class_name": "LinejamBackend" },
        ],
      },
      "vars": {
        "NEXT_PUBLIC_CONVEX_URL": "https://amiable-bulldog-848.convex.cloud",
        "NEXT_PUBLIC_SENTRY_ENABLED": "1",
        "SENTRY_ORG": "misty-step",
        "SENTRY_PROJECT": "linejam",
        "LINEJAM_DEPLOY_ENVIRONMENT": "production",
        // Convex runtime env for the Durable Object backend. The backend is
        // dormant until NEXT_PUBLIC_CONVEX_URL points at /backend. Values match
        // amiable-bulldog-848's (config/convex-env-manifest.json). It leaves
        // RETENTION_GC_ENABLED unset, so this does too: retention stays dry-run.
        "CONVEX_CLOUD_URL": "https://linejam.mistystep.io/backend",
        "CONVEX_SITE_URL": "https://linejam.mistystep.io/backend/http",
        "CLERK_JWT_ISSUER_DOMAIN": "https://clerk.linejam.mistystep.io",
        "LINEJAM_SENTRY_ENABLED": "true",
        "SENTRY_ENVIRONMENT": "production",
      },
      // NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (Clerk live key) and all server
      // secrets are bound at deploy with `wrangler secret put <NAME>
      // --env production` from the approved store; never committed.
    },
  },
}
