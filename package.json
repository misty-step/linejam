{
  "name": "linejam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pass-the-poem party game on Cloudflare Workers + Durable Objects (SQLite).",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "bin": {
    "linejam": "cli/linejam.ts",
    "linejam-mcp": "cli/mcp.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p cli/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "walk": "node e2e/walkthrough.mjs",
    "verify": "node scripts/verify.mjs",
    "cli": "node cli/linejam.ts",
    "mcp": "node cli/mcp.ts",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261127.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
